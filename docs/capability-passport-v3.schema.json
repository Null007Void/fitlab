{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FitLab Capability Passport v3",
  "description": "Structural interchange schema. Replay validation additionally checks source, grades, summaries, chronology, resource gates and determinism. Schema validation is not model evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "source",
    "evaluation_state",
    "capability_verdict",
    "complete_protocol",
    "claims",
    "tasks",
    "planning",
    "provenance_limit",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "fitlab-capability-passport-v3"
    },
    "title": {
      "const": "Lemonade FitLab"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "commit",
        "tree",
        "trust_sha256",
        "task_pack_sha256",
        "evaluation_sha256",
        "planning_sha256"
      ],
      "properties": {
        "binding": {
          "enum": [
            "LOCAL_GIT_VERIFIED",
            "EXTERNALLY_SUPPLIED_SNAPSHOT"
          ]
        },
        "commit": {
          "type": "string"
        },
        "tree": {
          "type": "string"
        },
        "trust_sha256": {
          "type": "string"
        },
        "task_pack_sha256": {
          "type": "string"
        },
        "evaluation_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "planning_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evaluation_state": {
      "enum": [
        "NO_EVIDENCE",
        "SYNTHETIC_ONLY",
        "RUNNING",
        "COMPLETED",
        "STOPPED",
        "INTERRUPTED"
      ]
    },
    "capability_verdict": {
      "enum": [
        "NOT_EVALUATED",
        "OBSERVED_TOY_TASKS_ONLY"
      ]
    },
    "complete_protocol": {
      "type": "boolean"
    },
    "claims": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "evidence_class",
          "value",
          "unit",
          "basis",
          "limitation",
          "evidence_label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "evidence_class": {
            "enum": [
              "MEASURED",
              "ESTIMATED",
              "CALCULATED",
              "DECLARED",
              "UNSUPPORTED",
              "UNKNOWN"
            ]
          },
          "value": {
            "type": [
              "number",
              "string",
              "object",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "basis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitation": {
            "type": "string"
          },
          "evidence_label": {
            "type": "string",
            "enum": [
              "MEASURED",
              "ANALYTICAL ESTIMATE",
              "SYNTHETIC TEST EVIDENCE",
              "HISTORICAL MEASURED EVIDENCE",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "tier",
          "observed",
          "passed",
          "planned",
          "evidence_class",
          "evidence_label"
        ],
        "properties": {
          "id": {
            "enum": [
              "E1",
              "E2",
              "E3",
              "D1",
              "D2",
              "D3",
              "D4",
              "D5"
            ]
          },
          "category": {
            "type": "string"
          },
          "tier": {
            "enum": [
              "core",
              "supplemental"
            ]
          },
          "observed": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "passed": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "planned": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 3
          },
          "evidence_class": {
            "enum": [
              "MEASURED",
              "UNKNOWN"
            ]
          },
          "evidence_label": {
            "type": "string",
            "enum": [
              "MEASURED",
              "ANALYTICAL ESTIMATE",
              "SYNTHETIC TEST EVIDENCE",
              "HISTORICAL MEASURED EVIDENCE",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    "planning": {
      "type": [
        "object",
        "null"
      ]
    },
    "planning_provenance": {
      "type": [
        "object",
        "null"
      ]
    },
    "memory_advisory": {
      "type": [
        "object",
        "null"
      ]
    },
    "host": {
      "type": [
        "object",
        "null"
      ]
    },
    "task_tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core",
        "supplemental",
        "denominator_policy",
        "approval_status"
      ],
      "properties": {
        "core": {
          "type": "object"
        },
        "supplemental": {
          "type": "object"
        },
        "denominator_policy": {
          "type": "object"
        },
        "approval_status": {
          "type": "string"
        }
      }
    },
    "provenance_limit": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_class": {
      "type": "string"
    },
    "evidence_class_vocabulary": {
      "type": "object",
      "required": [
        "analytical_estimate_from",
        "machine",
        "owner",
        "unchanged",
        "unsupported_presents_as"
      ],
      "properties": {
        "analytical_estimate_from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "machine": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owner": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unchanged": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsupported_presents_as": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "historical_campaign": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": true
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capability_verdict": {
            "const": "NOT_EVALUATED"
          }
        }
      },
      "then": {
        "properties": {
          "complete_protocol": {
            "const": false
          },
          "claims": {
            "items": {
              "properties": {
                "evidence_class": {
                  "not": {
                    "const": "MEASURED"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "$comment": "A task marked MEASURED requires an observed count greater than zero. A measured claim requires an eligible local-runtime evaluation, which only the replay validator can establish.",
      "if": {
        "properties": {
          "evaluation_state": {
            "enum": [
              "NO_EVIDENCE",
              "SYNTHETIC_ONLY"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "claims": {
            "items": {
              "properties": {
                "evidence_class": {
                  "not": {
                    "const": "MEASURED"
                  }
                }
              }
            }
          },
          "tasks": {
            "items": {
              "properties": {
                "evidence_class": {
                  "const": "UNKNOWN"
                }
              }
            }
          }
        }
      }
    }
  ]
}
